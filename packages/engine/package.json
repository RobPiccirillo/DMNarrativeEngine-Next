{
  "name": "@narrative/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Narrative Engine core — pure TypeScript game logic consumed by the desktop (mainApp) and mobile (mobileApp) shells.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./contracts/draftLifecycle": {
      "types": "./dist/contracts/draftLifecycle.d.ts",
      "import": "./dist/contracts/draftLifecycle.js"
    },
    "./contracts/draftCompatibility": {
      "types": "./dist/contracts/draftCompatibility.d.ts",
      "import": "./dist/contracts/draftCompatibility.js"
    },
    "./contracts/legacyAcceptance": {
      "types": "./dist/contracts/legacyAcceptance.d.ts",
      "import": "./dist/contracts/legacyAcceptance.js"
    },
    "./contracts/providerAttempt": {
      "types": "./dist/contracts/providerAttempt.d.ts",
      "import": "./dist/contracts/providerAttempt.js"
    },
    "./contracts/authorityControl": {
      "types": "./dist/contracts/authorityControl.d.ts",
      "import": "./dist/contracts/authorityControl.js"
    },
    "./contracts/authorityTransition": {
      "types": "./dist/contracts/authorityTransition.d.ts",
      "import": "./dist/contracts/authorityTransition.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./roles/roleIds": {
      "types": "./dist/roles/roleIds.d.ts",
      "import": "./dist/roles/roleIds.js"
    },
    "./mods/apiVersion": {
      "types": "./dist/mods/apiVersion.d.ts",
      "import": "./dist/mods/apiVersion.js"
    },
    "./contracts/identity": {
      "types": "./dist/contracts/identity.d.ts",
      "import": "./dist/contracts/identity.js"
    },
    "./contracts/mutation": {
      "types": "./dist/contracts/mutation.d.ts",
      "import": "./dist/contracts/mutation.js"
    },
    "./contracts/authorityRouter": {
      "types": "./dist/contracts/authorityRouter.d.ts",
      "import": "./dist/contracts/authorityRouter.js"
    },
    "./contracts/contextRecord": {
      "types": "./dist/contracts/contextRecord.d.ts",
      "import": "./dist/contracts/contextRecord.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "pretest": "node scripts/boundary-gate.mjs",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  }
}
